cyan-bright)}\n  .hero-aside ol {list-style: none;counter-reset: idx;margin: 0;padding: 0}\n  .hero-aside li {counter-increment: idx;padding: 13px 0;border-bottom: 1px solid #333e45;font-size: 0.9rem;color: #a7b2b8}\n  .hero-aside li::before {content: \"0\" counter(idx);display: inline-block;width: 30px;color: #6f7d84;font-family: Georgia, serif}\n  .hero-aside li a {color: #e3ecee}\n  .aside-note {margin: 18px 0 0;font-size: 0.8rem;line-height: 1.7;color: #85939a}\n\n  .section {padding: 76px 0}\n  .section.alt {background: #ffffff}\n  .sec-head {display: grid;grid-template-columns: 84px minmax(0, 1fr);gap: 24px;align-items: start;margin-bottom: 38px}\n  .num {padding-top: 8px;font-family: Georgia, \"Times New Roman\", serif;font-size: 0.92rem;letter-spacing: 0.16em;color: var(--cyan)}\n  h2 {font-family: \"Songti SC\", \"SimSun\", Georgia, serif;font-size: clamp(1.4rem, 2.6vw, 1.9rem);line-height: 1.44;font-weight: 600;margin: 0 0 10px}\n  .sub {margin: 0;color: var(--muted);font-size: 0.96rem}\n\n  .plan-list {list-style: none;margin: 0;padding: 0}\n  .plan {display: grid;grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.55fr);gap: 26px 48px;padding: 34px 0;border-top: 1px solid var(--line)}\n  .plan:last-child {border-bottom: 1px solid var(--line)}\n  .plan.featured {background: var(--cyan-soft);padding: 34px 26px;border-top-color: transparent}\n  .plan:last-child.featured {border-bottom-color: transparent}\n  .plan h3 {margin: 0 0 12px;font-size: 1.2rem;font-weight: 700;letter-spacing: 0.02em}\n  .tag {display: inline-block;margin-left: 10px;padding: 2px 9px;font-size: 0.68rem;font-weight: 400;letter-spacing: 0.12em;color: #ffffff;background: var(--cyan);border-radius: 2px;vertical-align: middle}\n  .price {margin: 0;font-family: Georgia, \"Times New Roman\", serif;font-size: 1.85rem;line-height: 1.2;color: #16202a}\n  .price .unit {font-family: \"PingFang SC\", \"Microsoft YaHei\", Arial, sans-serif;font-size: 0.82rem;color: var(--muted);letter-spacing: 0.04em}\n  .annual {margin: 6px 0 0;font-size: 0.84rem;color: var(--muted)}\n  .plan-note {margin: 16px 0 0;font-size: 0.9rem;line-height: 1.7;color: #4d5a61}\n  .feat {list-style: none;margin: 0;padding: 0;display: grid;gap: 10px}\n  .feat li {position: relative;padding-left: 22px;font-size: 0.96rem;color: #33404a}\n  .feat li::before {content: \"—\";position: absolute;left: 0;color: var(--cyan)}\n  .disclaimer {margin: 34px 0 0;padding: 20px 22px;background: #eaeef0;color: #51606a;font-size: 0.87rem;line-height: 1.75}\n\n  .client-grid {display: grid;grid-template-columns: repeat(3, minmax(0, 1fr));gap: 44px}\n  .client .label {margin: 0 0 10px;font-size: 0.7rem;letter-spacing: 0.2em;color: var(--cyan)}\n  .client h3 {margin: 0 0 10px;font-size: 1.05rem}\n  .client p {margin: 0;font-size: 0.94rem;line-height: 1.75;color: var(--muted)}\n  .client-foot {margin: 40px 0 0;padding-top: 22px;border-top: 1px solid var(--line);font-size: 0.88rem;color: #4d5a61}\n\n  .steps {list-style: none;counter-reset: step;margin: 0;padding: 0;display: grid;grid-template-columns: repeat(2, minmax(0, 1fr));gap: 34px 56px}\n  .steps li {counter-increment: step}\n  .steps li::before {content: \"0\" counter(step);display: block;margin-bottom: 6px;font-family: Georgia, \"Times New Roman\", serif;font-size: 1.5rem;color: #8ec9cd;letter-spacing: 0.08em}\n  .steps h3 {margin: 0 0 6px;font-size: 1.03rem}\n  .steps p {margin: 0;font-size: 0.94rem;line-height: 1.75;color: var(--muted)}\n\n  .faq-list {list-style: none;counter-reset: q;margin: 0;padding: 0}\n  .faq-list li {counter-increment: q;display: grid;grid-template-columns: 58px minmax(0, 1fr);gap: 22px;padding: 26px 0;border-top: 1px solid var(--line)}\n  .faq-list li:last-child {border-bottom: 1px solid var(--line)}\n  .faq-list li::before {content: counter(q, decimal-leading-zero);padding-top: 3px;font-family: Georgia, \"Times New Roman\", serif;font-size: 0.92rem;letter-spacing: 0.1em;color: var(--cyan)}\n  .faq-list h3 {margin: 0 0 6px;font-size: 1.01rem;line-height: 1.6}\n  .faq-list p {margin: 0;font-size: 0.94rem;line-height: 1.78;color: var(--muted)}\n\n  .site-foot {background: var(--deep);color: #94a2a9;padding: 44px 0 48px;font-size: 0.84rem;line-height: 1.8}\n  .foot-grid {display: flex;flex-wrap: wrap;justify-content: space-between;gap: 20px 40px}\n  .site-foot strong {display: block;color: #e6edef;letter-spacing: 0.16em;font-size: 0.9rem;margin-bottom: 8px}\n  .site-foot p {margin: 0;max-width: 620px}\n  .site-foot a {color: var(--cyan-bright)}\n\n  @media (max-width: 880px) {\n    .hero {padding: 52px 0 58px}\n    .hero-grid {grid-template-columns: 1fr;gap: 40px}\n    .hero-aside {border-left: 0;border-top: 1px solid #3c474e;padding-left: 0;padding-top: 24px}\n    .section {padding: 56px 0}\n    .sec-head {grid-template-columns: 1fr;gap: 6px}\n    .num {padding-top: 0}\n    .plan {grid-template-columns: 1fr;gap: 20px}\n    .plan.featured {padding: 28px 20px}\n    .client-grid {grid-template-columns: 1fr;gap: 30px}\n    .steps {grid-template-columns: 1fr;gap: 28px}\n    .faq-list li {grid-template-columns: 40px minmax(0, 1fr);gap: 14px}\n  }\n  @media (max-width: 520px) {\n    .bar nav {gap: 6px 16px}\n    .bar nav a {font-size: 0.78rem}\n    .plan-list .price {font-size: 1.65rem}\n  }\n</style><header class=\"topbar\">\n  <div class=\"bar\">\n    <span class=\"brand\">SaySS</span>\n    <nav aria-label=\"页面目录\">\n      <a href=\"#plans\">套餐参考</a>\n      <a href=\"#clients\">客户端</a>\n      <a href=\"#guide\">使用说明</a>\n      <a href=\"#faq\">常见问题</a>\n    </nav>\n  </div>\n</header>\n\n<main id=\"main\">\n\n  <section class=\"hero\">\n    <div class=\"wrap hero-grid\">\n      <div class=\"hero-main\">\n        <p class=\"kicker\">使用手册 · 阅读约 6 分钟</p>\n        <h1>SaySS：把套餐、客户端与使用说明放在同一页读完</h1>\n        <p class=\"lead\">这份页面的目的很单纯：当你在搜索 SaySS、SaySS 机场或 SaySS 客户端时，能在同一个地址里看到套餐结构、客户端分类和使用步骤，而不必在多个来源之间反复对照。</p>\n        <p>需要先说清楚的是，本页围绕 SaySS 这一关键词整理信息，不是交易入口。页面不提供注册、付款、订阅导入或安装包下载链接，也不对任何线路的速度与稳定性作出承诺。涉及实际开通、计费与售后的事项，应以你正在使用的服务渠道给出的说明为准。</p>\n        <p>阅读顺序建议从上到下：先看三档套餐的差别集中在哪几个维度，再确认手上的设备属于哪一类客户端，最后按使用说明完成导入与检查。如果只关心其中一部分，可以从右侧目录直接跳转。</p>\n        <p class=\"pull\">先看结构，再看步骤；先确认状态，再排查网络。大部分使用问题都能按这个顺序定位。</p>\n      </div>\n      <aside class=\"hero-aside\">\n        <p class=\"aside-title\">本页结构</p>\n        <ol>\n          <li><a href=\"#plans\">套餐参考</a>：三档纵向对照，比流量与设备数</li>\n          <li><a href=\"#clients\">客户端</a>：桌面、移动与路由器三种情况</li>\n          <li><a href=\"#guide\">使用说明</a>：从导入订阅到排查的六个步骤</li>\n          <li><a href=\"#faq\">常见问题</a>：价格、设备数、节点为空等疑问</li>\n        </ol>\n        <p class=\"aside-note\">页面内容为信息整理，不含购买与下载入口，也不代表任何官方授权渠道。</p>\n      </aside>\n    </div>\n  </section>\n\n  <section class=\"section\" id=\"plans\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"num\">01</span>\n        <div>\n          <h2>套餐参考：三档纵向逐行看清楚</h2>\n          <p class=\"sub\">每一行是一个档位。差别集中在四个维度：每月流量、同时在线设备数、节点类型与支持方式。</p>\n        </div>\n      </div>\n\n      <ol class=\"plan-list\">\n        <li class=\"plan\">\n          <div class=\"plan-head\">\n            <h3>基础版</h3>\n            <p class=\"price\">¥15<span class=\"unit\"> / 月</span></p>\n            <p class=\"annual\">按年付参考价 ¥150 / 年</p>\n            <p class=\"plan-note\">单人日常使用的起点档位，流量与设备数都偏保守，适合先确认自己的使用习惯。</p>\n          </div>\n          <ul class=\"feat\">\n            <li>每月 100GB 流量（参考值）</li>\n            <li>最多 3 台设备同时在线</li>\n            <li>基础流媒体解锁</li>\n            <li>普通线路节点池</li>\n          </ul>\n        </li>\n\n        <li class=\"plan featured\">\n          <div class=\"plan-head\">\n            <h3>旗舰版<span class=\"tag\">推荐参考</span></h3>\n            <p class=\"price\">¥35<span class=\"unit\"> / 月</span></p>\n            <p class=\"annual\">按年付参考价 ¥350 / 年</p>\n            <p class=\"plan-note\">在流量、设备数与线路类型之间取平衡的一档，适合多设备同时在线、对线路类型有要求的日常使用。</p>\n          </div>\n          <ul class=\"feat\">\n            <li>每月 300GB 流量（参考值）</li>\n            <li>最多 5 台设备同时在线</li>\n            <li>全节点原生流媒体解锁</li>\n            <li>IPLC 专线游戏加速优化</li>\n            <li>7×24 优先工单支持</li>\n          </ul>\n        </li>\n\n        <li class=\"plan\">\n          <div class=\"plan-head\">\n            <h3>团队版</h3>\n            <p class=\"price\">¥85<span class=\"unit\"> / 月</span></p>\n            <p class=\"annual\">按年付参考价 ¥850 / 年</p>\n            <p class=\"plan-note\">面向多人共用或小型团队，重点在设备数与流量上限，而不是单台设备的极致体验。</p>\n          </div>\n          <ul class=\"feat\">\n            <li>每月 1000GB 流量（参考值）</li>\n            <li>最多 20 台设备同时在线</li>\n            <li>VIP 专属高带宽节点</li>\n            <li>支持企业定制路由</li>\n            <li>专属客户经理服务</li>\n          </ul>\n        </li>\n      </ol>\n\n      <p class=\"disclaimer\">以上档位名称、价格与权益为页面整理的参考信息，只用于横向比较结构，不构成报价、承诺或销售要约。实际价格、流量计算方式、节点范围与支持响应时间，请以提供方的正式说明为准。本页不代办开通，不提供支付入口，也不处理订单与退款事宜。</p>\n    </div>\n  </section>\n\n  <section class=\"section alt\" id=\"clients\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"num\">02</span>\n        <div>\n          <h2>客户端：先确认设备，再决定装哪一个</h2>\n          <p class=\"sub\">客户端不是一个软件，而是一类工具。按设备类型分，通常落在桌面、移动与路由器三种情况里。</p>\n        </div>\n      </div>\n\n      <div class=\"client-grid\">\n        <article class=\"client\">\n          <p class=\"label\">桌面端</p>\n          <h3>Windows 与 macOS</h3>\n          <p>桌面端常见的做法是使用支持订阅导入的客户端：安装后把订阅地址粘贴到「订阅」或「配置」入口，保存并刷新节点列表即可。桌面端配置项较多，适合需要分流规则或需要排查问题的人。系统版本过旧时，部分客户端可能无法正常运行，安装前先看一下软件自身给出的系统要求。</p>\n        </article>\n        <article class=\"client\">\n          <p class=\"label\">移动端</p>\n          <h3>Android 与 iOS</h3>\n          <p>两类系统的处理方式并不一样。Android 通常可以直接安装客户端并导入订阅；iOS 的可用性受应用商店区域影响，不同地区上架情况不一致。因此本页不指定具体应用名称，也不提供下载地址。无论哪一种系统，导入前都应确认订阅地址没有被公开传播。</p>\n        </article>\n        <article class=\"client\">\n          <p class=\"label\">路由器与软路由</p>\n          <h3>网络层统一配置</h3>\n          <p>把配置放在路由器上，可以让同一网络下的设备共用一份连接，省去逐台设置的麻烦。这种方式对动手能力要求更高，升级与排错也更依赖设备本身，并且需要注意设备数如何计算。参考套餐没有对路由器场景单独说明，部署前建议先确认固件与客户端是否匹配。</p>\n        </article>\n      </div>\n\n      <p class=\"client-foot\">本页不提供任何客户端的安装包或下载地址。请只从你信任的来源获取软件，并在导入前确认订阅地址处于私密状态；不要把订阅链接发到公开群组、论坛或截图里。</p>\n    </div>\n  </section>\n\n  <section class=\"section\" id=\"guide\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"num\">03</span>\n        <div>\n          <h2>使用说明：六个步骤，从导入到排查</h2>\n          <p class=\"sub\">按顺序执行即可。每一步都给出判断依据，避免在不确定的情况下反复更换设置。</p>\n        </div>\n      </div>\n\n      <ol class=\"steps\">\n        <li>\n          <h3>确认账号与服务状态</h3>\n          <p>开始配置前，先确认订阅处于有效期之内，并核对同时在线设备数是否已经接近上限。超出上限时，常见的表现是已有设备频繁掉线，而不是完全无法连接。</p>\n        </li>\n        <li>\n          <h3>复制订阅地址</h3>\n          <p>订阅地址相当于一份配置文件，包含节点与规则信息。复制时注意不要带入多余空格或换行；同时不要把它发到公开渠道，一旦外泄，建议及时更换。</p>\n        </li>\n        <li>\n          <h3>选择客户端并导入</h3>\n          <p>打开与你设备匹配的客户端，找到「订阅」「配置」或「Profile」入口，粘贴地址后保存，等待列表拉取完成。部分客户端需要手动点一次刷新才会显示节点。</p>\n        </li>\n        <li>\n          <h3>选择节点并连接</h3>\n          <p>初次使用可以先选择延迟较低的节点，连接后打开一个常用网站确认是否生效。如果页面打不开，先换一个节点测试，以区分是节点问题还是本地设置问题。</p>\n        </li>\n        <li>\n          <h3>检查流量是否真的走了代理</h3>\n          <p>网页能打开但速度异常时，先看客户端的系统代理或分流规则是否开启，再检查本地安全软件是否拦截了连接。桌面端尤其容易出现「客户端已连接、系统代理未开启」的情况。</p>\n        </li>\n        <li>\n          <h3>按固定顺序排查故障</h3>\n          <p>建议顺序：订阅是否过期 → 客户端版本是否过旧 → 节点是否可用 → 本地网络是否正常 → 设备数是否超限。多数问题能在这五步之内定位，不必急于重装系统或更换设备。</p>\n        </li>\n      </ol>\n    </div>\n  </section>\n\n  <section class=\"section alt\" id=\"faq\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"num\">04</span>\n        <div>\n          <h2>常见问题：按编号查，答案写在问题下面</h2>\n          <p class=\"sub\">这些问题覆盖身份、价格、设备数、流量规则与客户端四个方向，回答尽量明确，也标出页面无法代为确认的部分。</p>\n        </div>\n      </div>\n\n      <ol class=\"faq-list\">\n        <li>\n          <article>\n            <h3>本页是 SaySS 的官方网站吗？</h3>\n            <p>不是。本页是围绕 SaySS 关键词整理的信息页，用于汇总套餐结构、客户端分类与使用步骤。页面没有获得品牌方授权，也不代表任何官方渠道，不提供注册、付款或下载入口。</p>\n          </article>\n        </li>\n        <li>\n          <article>\n            <h3>页面上的价格可以直接付款吗？</h3>\n            <p>不能。价格是参考信息，用于比较三档套餐之间的差异。实际价格、计费周期与优惠方式以提供方的正式页面为准。本页不处理订单，也不代收费用。</p>\n          </article>\n        </li>\n        <li>\n          <article>\n            <h3>一个账号可以同时在几台设备上使用？</h3>\n            <p>参考套餐中，基础版标注 3 台、旗舰版 5 台、团队版 20 台同时在线。这个数字通常指同一时间的在线设备数，而不是累计可登录的设备数。具体口径以提供方说明为准。</p>\n          </article>\n        </li>\n        <li>\n          <article>\n            <h3>流量用完了会怎样？</h3>\n            <p>常见处理方式有两种：当月停止服务，或降速后继续可用。具体规则取决于提供方的策略，本页无法代为确认。建议在开通前直接查看对应档位的流量说明与超量处理方式。</p>\n          </article>\n        </li>\n        <li>\n          <article>\n            <h3>导入订阅后看不到节点怎么办？</h3>\n            <p>先确认订阅地址完整、没有多余空格；再检查设备时间是否准确；然后尝试手动刷新订阅。如果列表仍然为空，可能是订阅已过期或地址已经更换，需要回到获取订阅的来源核对。</p>\n          </article>\n        </li>\n        <li>\n          <article>\n            <h3>iOS 上应该用哪个客户端？</h3>\n            <p>iOS 客户端的可用性受应用商店区域影响，不同地区的上架情况并不一致，因此本页不指定具体应用名称，也不提供下载链接。建议以提供方给出的客户端说明为准，并注意不要使用来源不明的安装方式。</p>\n          </article>\n        </li>\n        <li>\n          <article>\n            <h3>可以在路由器上使用吗？</h3>\n            <p>参考套餐没有对路由器场景单独说明。是否可行取决于客户端能否在你使用的路由器固件上运行，以及设备数如何计算。部署前建议先确认这两点，再决定是否把配置放到网络层。</p>\n          </article>\n        </li>\n        <li>\n          <article>\n            <h3>遇到问题应该怎么反馈？</h3>\n            <p>本页不提供客服入口。如果你已经在使用某个服务渠道，优先通过该渠道的工单或支持方式反馈，并附上客户端类型、系统版本、出错步骤与提示文字。信息越完整，排查越快。</p>\n          </article>\n        </li>\n      </ol>\n    </div>\n  </section>\n\n</main>\n\n<footer class=\"site-foot\">\n  <div class=\"wrap foot-grid\">\n    <div>\n      <strong>SaySS</strong>\n      <p>机场套餐、客户端与使用说明的信息整理页。内容为页面编写与结构说明，不构成对服务质量的承诺，也不代表官方授权渠道。</p>\n    </div>\n    <div>\n      <p><a href=\"#plans\">套餐参考</a> · <a href=\"#clients\">客户端</a> · <a href=\"#guide\">使用说明</a> · <a href=\"#faq\">常见问题</a></p>\n      <p>页面不含交易入口与下载链接。</p>\n    </div>\n  </div>\n</footer>",
